# Copy this file to .env.local and fill in your values.
# .env and .env.local are gitignored — never commit real secrets.

# Supabase (required for a live, editable site)
# https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your public site URL (canonicals, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://alusraclinics.com

# WhatsApp Business number for booking links (digits only, incl. country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=966137233900

# Optional: live Google Maps reviews (Places API "New")
# https://developers.google.com/maps/documentation/places/web-service/overview
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Offer-subscription leads → Google Sheets
# Deploy a Google Apps Script web app and paste its URL here. Each offer
# subscription on the site is POSTed to it as JSON:
#   { "name": "...", "email": "...", "phone": "...", "interests": ["dentistry"], "consent": true, "created_at": "..." }
# Apps Script example (doPost) appends the row to your sheet:
#   const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Leads") ||
#                 SpreadsheetApp.getActiveSpreadsheet().insertSheet("Leads");
#   function doPost(e) {
#     const d = JSON.parse(e.postData.contents);
#     sheet.appendRow([d.name, d.email, d.phone, (d.interests||[]).join(", "),
#                      d.consent ? "نعم" : "لا", d.created_at]);
#     return ContentService.createTextOutput(JSON.stringify({ ok: true }))
#       .setMimeType(ContentService.MimeType.JSON);
#   }
GOOGLE_SHEETS_WEBHOOK_URL=


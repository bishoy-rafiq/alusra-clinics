# Copy this file to .env.local and fill in your values.
# .env and .env.local are gitignored — never commit real secrets.

# Supabase (required for a live, editable site)
# https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your public site URL (canonicals, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://alusraclinics.com

# WhatsApp Business number for booking links (digits only, incl. country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=966137233900

# Optional: live Google Maps reviews (Places API "New")
# https://developers.google.com/maps/documentation/places/web-service/overview
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
